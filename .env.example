# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า
# OAuth Client ID จาก Google Cloud Console (ประเภท Web application)
GOOGLE_CLIENT_ID=
# (ไม่บังคับ) จำกัดให้ใช้ได้เฉพาะอีเมลโดเมนนี้ เช่น kmitl.ac.th
MIPSLAB_GOOGLE_DOMAIN=
# (ไม่บังคับ) section ที่ใส่ให้นักศึกษาที่ล็อกอินด้วย Google ครั้งแรก
MIPSLAB_DEFAULT_SECTION=
