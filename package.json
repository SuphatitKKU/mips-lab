{
  "name": "mips-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --no-warnings --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && tsc -p server && vite build",
    "start": "node --no-warnings --env-file-if-exists=.env --import tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "seed:demo": "tsx --no-warnings server/seed.ts",
    "user": "tsx --no-warnings server/cli.ts"
  },
  "dependencies": {
    "docx": "9.0.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.5"
  }
}
