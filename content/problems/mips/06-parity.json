{
  "id": "mips-parity",
  "title": "เลขคู่หรือเลขคี่",
  "category": "logic",
  "difficulty": "easy",
  "points": 10,
  "tests": [
    {
      "input": {
        "$a0": 6
      },
      "expected": {
        "$v0": 0
      }
    },
    {
      "input": {
        "$a0": 7
      },
      "expected": {
        "$v0": 1
      }
    },
    {
      "input": {
        "$a0": -3
      },
      "expected": {
        "$v0": 1
      }
    }
  ],
  "solution": {
        "c": "int main(int n) { return (n % 2 + 2) % 2; }",
    "asm": "andi $v0, $a0, 1"
  }
}
