  ],
  "solution": {
    "c": "int main(int n) { if (n < 0) return -n; return n; }",
    "asm": "move $v0, $a0\nslt $t0, $a0, $zero\nbeq $t0, $zero, end\nsubu $v0, $zero, $a0\nend: nop"
  }
